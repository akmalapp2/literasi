# Salin menjadi .env.local lalu isi dari Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# RAHASIA — hanya di server, jangan pernah diberi awalan NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Alamat aplikasi (dipakai untuk link & QR responden)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opsional: Cloudflare Turnstile untuk mode "Terbuka, anonim"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
